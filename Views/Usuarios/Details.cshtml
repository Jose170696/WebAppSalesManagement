@model WebAppSalesManagement.Models.Usuario

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Detalles del Usuario</h6>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.UsuarioID)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.UsuarioID)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NombreUsuario)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NombreUsuario)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NombreCompleto)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NombreCompleto)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Correo)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Correo)</dd>
                    </dl>
                </div>
                <div class="col-md-6">
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Estado)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Estado)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.RolNombre)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.RolNombre)</dd>

                        <dt class="col-sm-4">Fecha Registro</dt>
                        <dd class="col-sm-8">@(Model.FechaRegistro.HasValue ? Model.FechaRegistro.Value.ToString("dd/MM/yyyy HH:mm") : "-")</dd>
                    </dl>
                </div>
            </div>
            <div class="form-group mt-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al Listado
                </a>
            </div>
        </div>
    </div>
</div>
