@model WebAppSalesManagement.Models.VentaCompleta

@{
    ViewData["Title"] = "Eliminar Venta";
}

<h1>Eliminar Venta #@Model.VentaID</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="alert alert-danger">
    <h3>¿Está seguro que desea eliminar esta venta?</h3>
    <p>Esta acción no se puede deshacer.</p>
</div>

<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Información de la Venta</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">ID:</dt>
                    <dd class="col-sm-8">@Model.VentaID</dd>

                    <dt class="col-sm-4">Cliente:</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4">Fecha:</dt>
                    <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-4">Total:</dt>
                    <dd class="col-sm-8">@Model.Total.ToString("C")</dd>
                </dl>
            </div>
            <div class="col-md-6">
                <dl class="row">
                    <dt class="col-sm-4">Creado por:</dt>
                    <dd class="col-sm-8">@Model.AdicionadoPor</dd>

                    <dt class="col-sm-4">Fecha creación:</dt>
                    <dd class="col-sm-8">@Model.FechaAdicion.ToString("dd/MM/yyyy HH:mm")</dd>

                    @if (Model.ModificadoPor != null)
                    {
                        <dt class="col-sm-4">Modificado por:</dt>
                        <dd class="col-sm-8">@Model.ModificadoPor</dd>

                        <dt class="col-sm-4">Fecha modificación:</dt>
                        <dd class="col-sm-8">@(Model.FechaModificacion?.ToString("dd/MM/yyyy HH:mm"))</dd>
                    }
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header bg-info text-white">
        <h5 class="mb-0">Detalles de Productos</h5>
    </div>
    <div class="card-body">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Cantidad</th>
                    <th>Subtotal</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var detalle in Model.Detalles)
                {
                    <tr>
                        <td>@detalle.NombreProducto</td>
                        <td>@detalle.Cantidad</td>
                        <td>@detalle.Subtotal.ToString("C")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="2" class="text-right">Total:</th>
                    <th>@Model.Total.ToString("C")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.VentaID" />
    <button type="submit" class="btn btn-danger">Confirmar Eliminación</button>
    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
</form>